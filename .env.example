# Dyvine Plugin Configuration
# Local development and operator runs read this file (copy to .env).
# Installed plugins get DATABASE_URL and DOUYIN_COOKIE from the
# ``requires_env`` install prompt instead; the rest below keeps its
# documented defaults unless overridden.

# ================================
# Runtime
# ================================
# ``false`` outside local development: non-debug builds refuse to boot
# when DATABASE_URL still matches the localhost default below.
API_DEBUG=false

# Watch-loop scheduling. Worker processes that only serve CRUD set
# ``WATCH_ENABLED=false``; watcher loops (when enabled by the host)
# run on exactly one process, which adopts new rows through a
# periodic reconcile pass.
WATCH_ENABLED=true

# ================================
# Postgres Persistence Configuration
# ================================
# Operations, queue, seeds, send status, profiles, rounds, and watch
# state live in a shared Postgres database (asyncpg) — the only state
# store. Local development default (matches ``docker run
# -e POSTGRES_USER=dyvine -e POSTGRES_PASSWORD=dyvine
# -e POSTGRES_DB=dyvine -p 5432:5432 postgres:16``); non-debug
# deployments MUST override it.
DATABASE_URL=postgresql+asyncpg://dyvine:dyvine@localhost:5432/dyvine
# Connection-pool strategy: ``null`` (default) opens a fresh connection
# per use and holds none while idle, so a quiet process keeps zero
# database connections open; ``queue`` keeps a capped pool (see below)
# for deployments that prefer bounded concurrency over zero idle state.
DATABASE_POOL_CLASS=null
# Steady-state pooled connections per process (``queue`` only).
DATABASE_POOL_SIZE=5
# Burst connections beyond the pool size (``queue`` only).
DATABASE_POOL_MAX_OVERFLOW=2
# Seconds to wait for a pooled connection before failing (``queue`` only).
DATABASE_POOL_TIMEOUT=30
# Discard pooled connections older than this many seconds on next
# checkout (``queue`` only); ``-1`` disables recycling.
DATABASE_POOL_RECYCLE_SECONDS=300
# Probe a pooled connection before each checkout (``queue`` only;
# ``null`` always skips the probe on its fresh connections).
DATABASE_POOL_PRE_PING=true
# Seconds between janitor heartbeat/sweep passes. ``0`` (default)
# disables the loop: single processes keep boot recovery plus a daily
# retention purge and otherwise never touch the database while idle.
DATABASE_JANITOR_INTERVAL_SECONDS=0
# Terminal operation rows older than this many days are purged at boot
# and daily by the janitor; ``0`` disables purging.
DATABASE_OPERATION_RETENTION_DAYS=30
# NOTE: apply schema changes with ``uv run alembic upgrade head`` (same
# ``DATABASE_URL``) before tools run against the new schema.

# ================================
# Weekly Delivery (Hermes no-agent cron)
# ================================
# The runner evaluates the old Sunday 08:00 business schedule in this
# explicit timezone, independent of the host or Hermes cron timezone.
# Its cron wrapper should tick every 10 minutes; only one account is
# advanced per invocation.
DYVINE_WEEKLY_TIMEZONE=Asia/Shanghai
# Required first automatic round date (YYYY-MM-DD, Sunday). Set the first
# Sunday allowed to open a new round for this deployment.
DYVINE_WEEKLY_FIRST_AUTO_DATE=
# Required cutover anchor: the active legacy round being finished. Automatic
# new rounds wait for this round and unfinished auto rounds dated from the
# first-auto Sunday onward. Older frozen history does not block the schedule.
DYVINE_WEEKLY_CUTOVER_ROUND=
# Weekly Feishu group policy: returning accounts are identified by stable
# sec_user_id and reuse their Postgres-verified chat and topic in every
# round; only new accounts get a new
# group. Missing or conflicting historical destinations stay on hold.
# The new weekly cron remains paused through ledger and Feishu reconciliation.
DYVINE_WEEKLY_GROUP_POLICY=reuse_existing
# Required recipient for Feishu groups: the recipient's Feishu open_id,
# beginning with ``ou_``. Set this in the Hermes runtime environment.
DYVINE_WEEKLY_OWNER_OPEN_ID=
# During migration, keep DOUYIN_DOWNLOAD_ROOT at the legacy media path.
# A weekly progress file alone is not proof of file delivery; migrated
# entries await reconciliation before the runner can claim them.

# ================================
# Douyin Platform Configuration
# ================================
# Required: Get this from your browser after logging into Douyin
DOUYIN_COOKIE=

# Optional: Custom headers for requests
DOUYIN_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36
DOUYIN_REFERER=https://www.douyin.com/

# Root directory under which user-supplied ``output_path`` values are
# resolved. Path-traversal attempts that escape this root are rejected.
# Override only when the deployment writes downloads to a
# non-default volume.
DOUYIN_DOWNLOAD_ROOT=data/douyin/downloads

# Local-retention mode. When ``true`` the engine keeps each task's
# downloaded files under ``DOUYIN_DOWNLOAD_ROOT/tasks/<task_id>``
# instead of deleting them after the run, and R2 archival is skipped.
# Retention is applied implicitly whenever R2 is left unconfigured
# below, so a finished download is never discarded with nowhere to
# archive it. Default ``false``: upload to R2, then sweep the
# workspace.
DOUYIN_RETAIN_LOCAL_DOWNLOADS=false

# Soft cap, in GiB, on the retained-downloads workspace. When greater than
# zero, the oldest per-task directories are pruned after each run until the
# total falls back under the cap; ``0`` leaves the workspace unbounded.
DOUYIN_RETAIN_MAX_GB=0

# Optional: Proxy configuration
# DOUYIN_PROXY_HTTP=http://proxy.example.com:8080
# DOUYIN_PROXY_HTTPS=https://proxy.example.com:8080

# Optional: Livestream-specific HTTP headers
# These headers are sent with livestream API requests to live.douyin.com.
#
# CSRF token: Douyin's anti-automation token. Extract from browser DevTools
# (Network tab -> any live.douyin.com request -> x-secsdk-csrf-token header).
# Leave empty to omit the header entirely.
# DOUYIN_LIVE_CSRF_TOKEN=
#
# sec-ch-ua: Client Hints header identifying the browser. Update the version
# numbers to match the Chrome version used when extracting the cookie. Keep
# the single quotes: the value itself contains double quotes, and
# python-dotenv skips the line without them.
DOUYIN_LIVE_SEC_CH_UA='"Not A(Brand";v="99", "Google Chrome";v="131", "Chromium";v="131"'

# Argus webSign signing session. Douyin's web APIs require a per-request
# signature triple (uifid/timestamp/x-secsdk-web-signature) computed by the
# SecureSDK inside a real browser session; dyvine keeps one headless
# Chromium page for signing only -- all API traffic and downloads stay on
# plain HTTP. The host must provide a matching Chromium build
# (``playwright install chromium`` once). The wheel is pinned in
# ``pyproject.toml`` because the wheel and the browser build are a
# validated pair; bump them together.
# Disable only as a kill-switch: gated endpoints return HTTP 403 without it.
DOUYIN_WEBSIGN_ENABLED=true
DOUYIN_WEBSIGN_PAGE_URL=https://www.douyin.com/
DOUYIN_WEBSIGN_INIT_TIMEOUT_SECONDS=120
DOUYIN_WEBSIGN_SIGN_TIMEOUT_SECONDS=30
DOUYIN_WEBSIGN_RETRY_ONCE=true

# ================================
# Watch Mode (auto-download) Configuration
# ================================
# The watcher polls subscribed users and auto-downloads their new posts
# and livestreams. Every value below is a default; per-subscription
# overrides stay within the same bounds. Subscriptions persist in the
# shared Postgres database. Loops run only where ``WATCH_ENABLED=true``.
#
# Seconds between live-status checks (60..3600). Lower is more timely but
# polls Douyin more aggressively, raising the cookie/account risk.
DOUYIN_WATCH_LIVE_POLL_SECONDS=300
# Seconds between new-post checks (300..86400).
DOUYIN_WATCH_POST_POLL_SECONDS=2700
# Max aweme_ids kept in each subscription's dedupe checkpoint (20..2000).
DOUYIN_WATCH_RECENT_ID_CAP=200
# Maximum number of concurrent watch subscriptions (1..10000).
DOUYIN_WATCH_MAX_SUBSCRIPTIONS=50
# When true, a new subscription downloads the user's existing posts once
# before switching to incremental-only mode. Default false: only fetch
# posts published after the subscription is created.
DOUYIN_WATCH_BACKFILL_ON_CREATE=false

# ================================
# Cloudflare R2 Storage Configuration
# ================================
# Optional: Configure for automatic content uploads to R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

# ================================
# Notes on logging
# ================================
# The plugin installs no log handlers and writes no log file of its own:
# nothing calls ``core.logging.setup_logging``, so no ``logs/dyvine.log``
# is created. Engine modules log through the standard ``logging`` module
# under their ``dyvine.*`` names, and the host process (Hermes) decides
# level, format, and destination. There is no ``LOG_LEVEL`` /
# ``LOG_FORMAT`` environment override.

# ================================
# Usage Instructions
# ================================
# 1. Copy this file to .env
# 2. Set DATABASE_URL to the shared Postgres
# 3. Configure DOUYIN_COOKIE with your session data
# 4. Configure R2 settings if using cloud storage
# 5. Run ``uv run alembic upgrade head`` once per schema change

# ================================
# Getting Douyin Cookie
# ================================
# 1. Open Douyin.com in your browser
# 2. Log in to your account
# 3. Open browser developer tools (F12)
# 4. Go to Network tab and reload the page
# 5. Find any request to douyin.com
# 6. Copy the entire Cookie header value
# 7. Paste it as the DOUYIN_COOKIE value above
